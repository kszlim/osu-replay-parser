from collections.abc import Iterable, Iterator, MutableSequence
from datetime import datetime
from typing import overload

from osrparse.replay import Replay as Replay
from osrparse.utils import GameMode
from osrparse.utils import ReplayEvent as ReplayEvent
from osrparse.utils import ReplayEventCatch as ReplayEventCatch
from osrparse.utils import ReplayEventMania as ReplayEventMania
from osrparse.utils import ReplayEventOsu as ReplayEventOsu
from osrparse.utils import ReplayEventTaiko as ReplayEventTaiko

class ReplayData(MutableSequence[ReplayEvent]):
    def __init__(self, items: Iterable[ReplayEvent] | None = None) -> None: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> ReplayEvent: ...
    @overload
    def __getitem__(self, index: slice) -> list[ReplayEvent]: ...
    @overload
    def __setitem__(self, index: int, value: ReplayEvent) -> None: ...
    @overload
    def __setitem__(self, index: slice, value: Iterable[ReplayEvent]) -> None: ...
    def __delitem__(self, index: int | slice) -> None: ...
    def insert(self, index: int, value: ReplayEvent) -> None: ...
    def __iter__(self) -> Iterator[ReplayEvent]: ...
    def copy(self) -> list[ReplayEvent]: ...
    @property
    def _cached_event_count(self) -> int: ...

def unpack(data: bytes, replay_type: type[Replay]) -> Replay: ...
def unpack_timestamp(data: bytes) -> datetime: ...
def parse_events(
    text: str, mode: GameMode
) -> tuple[MutableSequence[ReplayEvent], int | None]: ...
def parse_replay_data(
    data: str | bytes,
    *,
    decoded: bool = False,
    decompressed: bool = False,
    mode: GameMode,
) -> MutableSequence[ReplayEvent]: ...
def pack(
    replay: Replay, *, dict_size: int | None = None, mode: int | None = None
) -> bytes: ...
def _format_float(value: float) -> str: ...
