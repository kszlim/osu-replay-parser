# Native API declarations; model contracts are defined in the Python modules.
from collections.abc import Callable, Iterable, Iterator, MutableSequence
from datetime import datetime
from typing import Any, final, overload

from osrparse.replay import Replay as Replay
from osrparse.utils import GameMode
from osrparse.utils import ReplayEvent as ReplayEvent
from osrparse.utils import ReplayEventCatch as ReplayEventCatch
from osrparse.utils import ReplayEventMania as ReplayEventMania
from osrparse.utils import ReplayEventOsu as ReplayEventOsu
from osrparse.utils import ReplayEventTaiko as ReplayEventTaiko

@final
class ReplayData(MutableSequence[ReplayEvent]):
    def __contains__(self, value: Any, /) -> bool: ...
    def __copy__(self, /) -> ReplayData: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ge__(self, other: object, /) -> bool: ...
    def __gt__(self, other: object, /) -> bool: ...
    def __le__(self, other: object, /) -> bool: ...
    def __len__(self, /) -> int: ...
    def __lt__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __new__(cls, /, items: Iterable[ReplayEvent] | None = None) -> ReplayData: ...
    def __reduce__(self, /) -> Any: ...
    def __repr__(self, /) -> str: ...
    def __setstate__(self, /, state: list[ReplayEvent]) -> None: ...
    @property
    def _cached_event_count(self, /) -> int: ...
    def append(self, /, value: ReplayEvent) -> None: ...
    def clear(self, /) -> None: ...
    def copy(self, /) -> list[ReplayEvent]: ...
    def count(self, /, value: ReplayEvent) -> int: ...
    def extend(self, /, values: Iterable[ReplayEvent]) -> None: ...
    def index(
        self, /, value: ReplayEvent, start: int = 0, stop: int | None = None
    ) -> int: ...
    def insert(self, /, index: int, value: ReplayEvent) -> None: ...
    def pop(self, /, index: int = ...) -> ReplayEvent: ...
    def remove(self, /, value: ReplayEvent) -> None: ...
    def reverse(self, /) -> None: ...
    def sort(
        self,
        /,
        *,
        key: Callable[[ReplayEvent], Any] | None = None,
        reverse: bool = False,
    ) -> None: ...
    @overload
    def __getitem__(self, index: int) -> ReplayEvent: ...
    @overload
    def __getitem__(self, index: slice) -> list[ReplayEvent]: ...
    @overload
    def __setitem__(self, index: int, value: ReplayEvent) -> None: ...
    @overload
    def __setitem__(self, index: slice, value: Iterable[ReplayEvent]) -> None: ...
    def __delitem__(self, index: int | slice) -> None: ...
    def __iter__(self) -> Iterator[ReplayEvent]: ...
    def __iadd__(self, other: Iterable[ReplayEvent]) -> ReplayData: ...
    def __imul__(self, count: int) -> ReplayData: ...
    def __add__(self, other: list[ReplayEvent] | ReplayData) -> list[ReplayEvent]: ...
    def __radd__(self, other: list[ReplayEvent]) -> list[ReplayEvent]: ...
    def __mul__(self, count: int) -> list[ReplayEvent]: ...
    def __rmul__(self, count: int) -> list[ReplayEvent]: ...

def _format_float(value: float) -> str: ...
def pack(
    replay: Replay, *, dict_size: int | None = None, mode: int | None = None
) -> bytes: ...
def parse_replay_data(
    data: str | bytes,
    *,
    decoded: bool = False,
    decompressed: bool = False,
    mode: GameMode,
) -> ReplayData: ...
def unpack(data: bytes) -> Replay: ...
def unpack_timestamp(data: bytes) -> datetime: ...
